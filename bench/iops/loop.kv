// Same a=a+1 loop as loop.py. N from the inner literal (keep in sync with IOPS_N when running).
rwfunc test() -> () {
	1000000 -> n
	0 -> a
	t0 <- time·now()
	while (a < n) {
		a = a + 1
	}
	t1 <- time·now()
	delta <- time·sub(t1, t0)
	ns <- time/duration·as_nanos(delta)
	println("kvlang n=", n)
	println("ns=", ns)
	println("a=", a)
}
