// 2-d compact ARRAYND: m[i,j]=1 then checksum. Hits xv.set/at nidx=2.
rwfunc test() -> () {
	m <- xv·reshape([0, 0, 0, 0, 0, 0, 0, 0], 2, 4)
	20000 -> n
	0 -> k
	t0 <- time·now()
	while (k < n) {
		0 -> i
		while (i < 2) {
			0 -> j
			while (j < 4) {
				1 -> m[i, j]
				j <- j + 1
			}
			i <- i + 1
		}
		k <- k + 1
	}
	t1 <- time·now()
	delta <- time·sub(t1, t0)
	ns <- time/duration·as_nanos(delta)
	0 -> acc
	0 -> i
	while (i < 2) {
		0 -> j
		while (j < 4) {
			x <- m[i, j]
			acc <- acc + x
			j <- j + 1
		}
		i <- i + 1
	}
	println("shape=arraynd-2d")
	println("kvlang-2d n=", n)
	println("ns=", ns)
	println("acc=", acc)
}
