// Nested integer while, no println in the nest. Outer+inner should specialize as one region.
rwfunc test() -> () {
	400 -> N
	0 -> acc
	0 -> n
	t0 <- time·now()
	while (n < N) {
		0 -> i
		while (i < N) {
			acc <- acc + 1
			i <- i + 1
		}
		n <- n + 1
	}
	t1 <- time·now()
	delta <- time·sub(t1, t0)
	ns <- time/duration·as_nanos(delta)
	println("shape=nested-while")
	println("kvlang-nested N=", N)
	println("ns=", ns)
	println("acc=", acc)
	println("n=", n)
}
