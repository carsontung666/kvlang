// rem/eq/inner-if: sum odds. Hits tight-loop specialization (not add-only).
rwfunc test() -> () {
	1000000 -> n
	0 -> total
	1 -> i
	t0 <- time·now()
	while (i <= n) {
		rem = i % 2
		rem == 1 -> is_odd
		if (is_odd) {
			total <- total + i
		}
		i = i + 1
	}
	t1 <- time·now()
	delta <- time·sub(t1, t0)
	ns <- time/duration·as_nanos(delta)
	println("shape=rem/eq/if")
	println("kvlang-odds n=", n)
	println("ns=", ns)
	println("total=", total)
	println("i=", i)
}
