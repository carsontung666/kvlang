// Tutorial sieve algorithm, no println in the nest. Count primes <= 200.
rwfunc test() -> () {
	200 -> limit
	0 -> count
	2 -> n
	t0 <- time·now()
	while (n <= limit) {
		is_prime <- true
		2 -> d
		while (d < n) {
			n % d -> rem
			divisible <- rem == 0
			if (divisible) {
				is_prime = false
				break
			} else {
				d <- d + 1
			}
		}
		if (is_prime) {
			count = count + 1
		}
		n + 1 -> n
	}
	t1 <- time·now()
	delta <- time·sub(t1, t0)
	ns <- time/duration·as_nanos(delta)
	println("shape=sieve-noprint")
	println("kvlang-sieve limit=", limit)
	println("ns=", ns)
	println("count=", count)
}
