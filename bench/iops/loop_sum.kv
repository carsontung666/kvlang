// while (i <= n) { acc += i; i += 1 }  — integer small-loop specialization
rwfunc test() -> () {
	1000000 -> n
	0 -> acc
	1 -> i
	t0 <- time·now()
	while (i <= n) {
		acc <- acc + i
		i <- i + 1
	}
	t1 <- time·now()
	delta <- time·sub(t1, t0)
	ns <- time/duration·as_nanos(delta)
	println("kvlang-sum n=", n)
	println("ns=", ns)
	println("acc=", acc)
	println("i=", i)
}
