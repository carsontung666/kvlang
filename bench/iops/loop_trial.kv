// Nested trial division, no println in the nest. Count primes <= limit.
rwfunc test() -> () {
	500 -> limit
	0 -> np
	2 -> n
	t0 <- time·now()
	while (n <= limit) {
		is_prime <- true
		2 -> d
		while (d < n) {
			n % d -> rem
			if (rem == 0) {
				is_prime = false
				break
			} else {
				d <- d + 1
			}
		}
		if (is_prime) {
			np <- np + 1
		}
		n + 1 -> n
	}
	t1 <- time·now()
	delta <- time·sub(t1, t0)
	ns <- time/duration·as_nanos(delta)
	println("shape=nested-trial")
	println("kvlang-trial limit=", limit)
	println("ns=", ns)
	println("np=", np)
}
