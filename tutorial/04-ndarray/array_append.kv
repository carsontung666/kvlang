// array_append: 向数组追加元素
// 规范依据: 02-kvspace模型/07-数组两种物理形态 —— array·append 作用于 compact 时
//           先自动 scatter，即 compact 数组必须能直接 append
// 语义: compact [1,2,3] 追加 4 后应有 4 个元素
// 期望输出:
//   4
rwfunc test() -> () {
	a:[]int64 = [1, 2, 3]
	array·append(a, 4) -> a
	ndarray·numel(a) -> n
	println(n)
}
