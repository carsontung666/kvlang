// kvspace·cp：拷贝单 key，之后改 src 不影响 dst
// 期望输出:
//   dst: 10
//   src after: 20
//   dst after: 10

rwfunc test() -> () {
	kvspace·set("/cp_src", 10)
	kvspace·cp("/cp_src", "/cp_dst")
	d1 = kvspace·get("/cp_dst")
	println("dst:", d1)
	kvspace·set("/cp_src", 20)
	s2 = kvspace·get("/cp_src")
	d2 = kvspace·get("/cp_dst")
	println("src after:", s2)
	println("dst after:", d2)
}
